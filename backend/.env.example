# Copie para .env em desenvolvimento. Em produção, configure estas variáveis na Railway.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.up.railway.app
# String de conexão da Neon (Dashboard > Connection string). Sem ela, usa SQLite local.
DATABASE_URL=postgresql://usuario:senha@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Domínio(s) do front na Vercel, separados por vírgula
CORS_ALLOWED_ORIGINS=http://localhost:5000,https://escuelita-ten.vercel.app
CSRF_TRUSTED_ORIGINS=https://*.up.railway.app
# Armazenamento de imagens (Cloudinary, plano gratuito). Sem ela, salva em /media local.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Endereço secreto do gestor de conteúdo. Ex.: gestor-8f3k2q → https://SEU-BACKEND/gestor-8f3k2q/
ADMIN_PATH=admin
# Endereço público do site (botões "Ver el sitio" do gestor)
FRONTEND_URL=https://escuelita-ten.vercel.app
# Chave compartilhada entre front e back para o formulário de contato
CONTACT_API_KEY=troque-por-outra-chave
# Primeiro administrador, criado no deploy se ainda não existir (depois pode remover a senha daqui)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=troque-por-uma-senha-forte
DJANGO_SUPERUSER_EMAIL=
