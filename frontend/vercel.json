{
  "functions": {
    "api/index.py": { "includeFiles": "{templates,content}/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index?__path=/$1" }],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, immutable" }]
    }
  ]
}
