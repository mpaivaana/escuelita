# URL pública do backend na Railway (ex.: https://escuelita-production.up.railway.app)
API_URL=https://escuelita-cms.up.railway.app
# Mesma chave definida no backend
CONTACT_API_KEY=troque-por-outra-chave
# Segundos que o conteúdo fica em cache no front (mantenha baixo: edições do gestor aparecem após esse tempo)
CONTENT_TTL=5
